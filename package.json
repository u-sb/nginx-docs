    "@tailwindcss/vite": "^4.3.5",
    "@takumi-rs/core": "^2.22.1",
    "@takumi-rs/helpers": "^2.22.1",
    "astro": "^7.4.13",
    "feed": "^6.0.0",
    "flag-icons": "^7.6.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.1",
    "react": "^19.3.1",
