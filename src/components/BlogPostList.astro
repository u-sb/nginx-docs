---
import {tagSlug, formatDate, type BlogPost} from '@/lib/posts';

interface Props {
    posts: BlogPost[];
    activeTag?: string;
}

const {posts, activeTag} = Astro.props;
---
<ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => (
            <li class="flex">
                <div class="flex w-full flex-col rounded-lg border border-white/10 bg-cell p-5 transition-[border-color,transform,background-color] duration-200 ease-out hover:-translate-y-0.5 hover:border-white/20 hover:bg-[#13151a]">
                    <a href={`/blog/${post.id}/`} title={post.data.title}
                       class="group block text-ink hover:text-ink">
                        <h2 class="font-display text-[17px] font-semibold leading-[1.35] tracking-[-0.3px] text-ink transition-colors group-hover:text-acc2">
                            {post.data.title}
                        </h2>
                        <p class="mt-2 mb-4 line-clamp-3 text-[13.5px] leading-[1.6] text-soft">{post.data.excerpt}</p>
                    </a>
                    <div class="mt-auto flex flex-wrap items-baseline gap-x-2.5 gap-y-1 border-t border-white/6 pt-3 font-mono text-[11.5px] text-faint">
                        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                        {post.data.tags.map((tag) => {
                            const slug = tagSlug(tag);
                            const active = activeTag === slug;
                            return (
                                    <a href={`/tags/${slug}/`}
                                       title={`Posts tagged #${tag}`}
                                       class:list={[
                                           'transition-colors hover:text-acc2',
                                           active ? 'text-acc2' : 'text-mute',
                                       ]}>#{tag}</a>
                            );
                        })}
                    </div>
                </div>
            </li>
    ))}
</ul>
