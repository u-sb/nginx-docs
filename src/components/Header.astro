---
import website_config, {versions} from '@/lib/website_config';

const pathname = Astro.url.pathname;
const isActive = (path: string) =>
    path === '/' ? pathname === '/' : pathname === path || pathname.startsWith(path);
---
<header class="sticky top-0 z-50 border-b border-white/9 bg-[rgba(11,12,14,0.85)] backdrop-blur-[12px]">
    <nav class="mx-auto flex h-[58px] max-w-[1120px] items-center gap-8 px-8">
        <a href="/" class="flex items-center gap-2 font-mono text-[16px] font-bold tracking-[-0.3px] text-ink hover:text-ink">
            <img src="/logo.svg" alt="" width="22" height="22" class="block"/>
            <span>n<span class="text-acc">.</span>wtf</span>
        </a>
        <div class="flex-1"></div>
        <div class="hidden items-center gap-[26px] text-[13.5px] md:flex">
            {website_config.navbar.map((item) => (
                    <a href={item.path}
                       class:list={[
                           'transition-colors',
                           isActive(item.path)
                               ? 'font-medium text-ink hover:text-ink'
                               : 'font-normal text-mute hover:text-ink',
                       ]}
                       aria-current={isActive(item.path) ? 'page' : undefined}>{item.title}</a>
            ))}
        </div>
        <div class="flex items-center gap-[18px] md:ml-1.5">
            <span class="font-mono text-[12px] text-faint">v{versions.nginx}</span>
            <button id="search-open" aria-label="Search"
                    class="grid cursor-pointer place-items-center text-mute transition-colors hover:text-ink">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"/>
                    <path d="M21 21l-6 -6"/>
                </svg>
            </button>
            <a href="/atom.xml" class="grid place-items-center text-mute transition-colors hover:text-ink"
               aria-label="Atom feed">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M4 19a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
                    <path d="M4 4a16 16 0 0 1 16 16"/>
                    <path d="M4 11a9 9 0 0 1 9 9"/>
                </svg>
            </a>
            <a href={website_config.github} class="grid place-items-center text-mute transition-colors hover:text-ink"
               aria-label="GitHub">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.2-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.75.81 1.2 1.84 1.2 3.1 0 4.43-2.7 5.4-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/>
                </svg>
            </a>
            <details class="relative md:hidden" id="mobile-menu">
                <summary class="grid cursor-pointer list-none place-items-center text-mute transition-colors hover:text-ink [&::-webkit-details-marker]:hidden"
                         aria-label="Menu">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" aria-hidden="true">
                        <line x1="4" y1="7" x2="20" y2="7"/>
                        <line x1="4" y1="12" x2="20" y2="12"/>
                        <line x1="4" y1="17" x2="20" y2="17"/>
                    </svg>
                </summary>
                <div class="absolute right-0 top-[calc(100%+14px)] flex w-48 flex-col gap-1 rounded-lg border border-white/10 bg-panel p-2 shadow-[0_12px_32px_rgba(0,0,0,0.5)]">
                    {website_config.navbar.map((item) => (
                            <a href={item.path}
                               class:list={[
                                   'rounded-md px-3 py-2 text-[13.5px] transition-colors',
                                   isActive(item.path)
                                       ? 'bg-white/5 font-medium text-ink hover:text-ink'
                                       : 'font-normal text-mute hover:bg-white/5 hover:text-ink',
                               ]}>{item.title}</a>
                    ))}
                </div>
            </details>
        </div>
    </nav>
</header>
<script>
    // Close the mobile menu when tapping outside of it.
    document.addEventListener('click', (e) => {
        const menu = document.getElementById('mobile-menu') as HTMLDetailsElement | null;
        if (menu?.open && e.target instanceof Node && !menu.contains(e.target)) menu.open = false;
    });
</script>
