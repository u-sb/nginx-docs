---
import website_config from '@/lib/website_config';

interface Props {
    title?: string;
    description?: string;
    keywords?: string;
    pageType?: 'website' | 'article';
    canonical?: string;
    noindex?: boolean;
    publishedTime?: string;
    modifiedTime?: string;
    articleTags?: string[];
}

const {title, description, keywords, pageType = 'website', canonical, noindex = false, publishedTime, modifiedTime, articleTags} = Astro.props;

const isHome = Astro.url.pathname === '/';
const fullTitle = isHome || !title ? website_config.title : `${title} - ${website_config.title}`;
const pageDescription = description ?? website_config.description;
const ogSlug = Astro.url.pathname.replace(/^\/+|\/+$/g, '') || 'index';
const ogImage = `${website_config.baseUrl}/images/${ogSlug}.webp`;
---
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{fullTitle}</title>
<meta name="description" content={pageDescription}/>
{keywords && <meta name="keywords" content={keywords}/>}
{noindex && <meta name="robots" content="noindex, follow"/>}
{canonical && <link rel="canonical" href={`${website_config.baseUrl}${canonical}`}/>}
<meta property="og:title" content={fullTitle}/>
<meta property="og:type" content={pageType === 'website' ? 'website' : 'article'}/>
<meta property="og:description" content={pageDescription}/>
<meta property="og:image" content={ogImage}/>
<meta property="og:image:width" content="1200"/>
<meta property="og:image:height" content="630"/>
<meta property="og:image:alt" content={website_config.title}/>
<meta property="og:site_name" content={website_config.title}/>
<meta property="og:locale" content="en_US"/>
{canonical && <meta property="og:url" content={`${website_config.baseUrl}${canonical}`}/>}
{pageType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime}/>}
{pageType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime}/>}
{pageType === 'article' && articleTags?.map((t) => <meta property="article:tag" content={t}/>)}
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content={fullTitle}/>
<meta name="twitter:description" content={pageDescription}/>
<meta name="twitter:image" content={ogImage}/>
<link rel="alternate" type="application/atom+xml" href={`${website_config.baseUrl}/atom.xml`}/>
<link rel="alternate" type="application/rss+xml" href={`${website_config.baseUrl}/rss.xml`}/>
<link rel="icon" href="/favicon.ico" sizes="32x32"/>
<link rel="icon" type="image/svg+xml" href="/logo.svg"/>
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"/>
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png"/>
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
<link rel="manifest" href="/site.webmanifest"/>
