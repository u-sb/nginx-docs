---
import {tagSlug} from '@/lib/posts';

interface TagItem {
    name: string;
    count: number;
}

interface Props {
    tags: TagItem[];
}

const {tags} = Astro.props;
const sorted = [...tags].sort((a, b) => a.name.localeCompare(b.name, 'en', {sensitivity: 'base'}));
---
<div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
    {sorted.map((tag) => (
            <a href={`/tags/${tagSlug(tag.name)}/`}
               title={`Posts tagged #${tag.name} (${tag.count})`}
               class="flex items-baseline justify-between gap-3 rounded-lg border border-white/10 bg-cell p-4 transition-[border-color,transform,background-color] duration-200 ease-out hover:-translate-y-0.5 hover:border-white/20 hover:bg-[#13151a]">
                <span class="min-w-0 truncate font-mono text-[13.5px] text-ink">#{tag.name}</span>
                <span class="shrink-0 font-mono text-[11.5px] text-faint">{tag.count} {tag.count === 1 ? 'post' : 'posts'}</span>
            </a>
    ))}
</div>
