---
import website_config from '@/lib/website_config';

// Build-time year as fallback; a small script below keeps it current at runtime.
const year = new Date().getFullYear();

const columns = [
    {
        title: 'Docs',
        links: [
            {title: 'Introduction', href: '/intro/'},
            {title: 'Installation', href: '/install/'},
            {title: 'Features', href: '/features/'},
            {title: 'Modules', href: '/modules/'},
        ],
    },
    {
        title: 'Repository',
        links: [
            {title: 'Mirrors', href: '/mirrors/'},
            {title: 'Changelog', href: '/changelog/'},
            {title: 'Blog', href: '/blog/'},
        ],
    },
    {
        title: 'Project',
        links: [
            {title: 'GitHub', href: website_config.github},
            {title: 'Issues', href: `${website_config.github}/issues`},
            {title: 'Contact', href: '/contact/'},
        ],
    },
];
---
<footer class="border-t border-white/9">
    <div class="mx-auto grid max-w-[1120px] grid-cols-1 gap-10 px-8 pb-9 pt-12 sm:grid-cols-2 md:grid-cols-[1.6fr_1fr_1fr_1fr]">
        <div>
            <div class="flex items-center gap-2 font-mono text-[15px] font-bold text-ink">
                <img src="/logo.svg" alt="" width="20" height="20" class="block"/>
                <span>n<span class="text-acc">.</span>wtf</span>
            </div>
            <p class="mt-3.5 max-w-[270px] text-[13.5px] leading-relaxed text-mute">An open-source nginx repository
                for Debian &amp; Ubuntu, packed with the latest features.</p>
        </div>
        {columns.map((col) => (
                <div>
                    <div class="mb-3.5 font-mono text-[11px] uppercase tracking-[0.8px] text-faint">{col.title}</div>
                    <div class="flex flex-col gap-[9px] text-[13.5px]">
                        {col.links.map((link) => (
                                <a href={link.href} class="text-soft transition-colors hover:text-ink">{link.title}</a>
                        ))}
                    </div>
                </div>
        ))}
    </div>
    <div class="border-t border-white/6">
        <div class="mx-auto flex max-w-[1120px] flex-wrap justify-between gap-3 px-8 py-[18px] font-mono text-[12px] text-faint">
            <span>© 2019 - <span data-footer-year>{year}</span> <a href="https://m.ac/"
                                                  class="text-mute transition-colors hover:text-ink">m.ac</a> · All Rights Reserved</span>
            <span>NGINX is a trademark of F5, Inc. — not affiliated</span>
        </div>
    </div>
</footer>

<script>
    // Keep the copyright year current on a statically built page.
    const el = document.querySelector('[data-footer-year]');
    if (el) el.textContent = String(new Date().getFullYear());
</script>
