---
import DocsLayout from '@/layouts/DocsLayout.astro';
import ArrowRight from '@/components/icons/ArrowRight.astro';
import {moduleDetails} from '@/data/module-details';

const staticCount = moduleDetails.filter((m) => m.kind === 'static').length;
const dynamicCount = moduleDetails.length - staticCount;
---
<DocsLayout title="Modules"
            description={`The ${moduleDetails.length} third-party modules built into every n.wtf nginx package.`}
            slug="modules"
            headings={[]}
            wide>
    <span slot="lede">The {moduleDetails.length} third-party modules built into every <span class="font-mono text-[15px] text-[#e3e5e8]">n.wtf</span> nginx package: {staticCount} compiled in, {dynamicCount} loadable.</span>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {moduleDetails.map((m) => (
                <a href={`/modules/${m.slug}/`}
                   class="flex flex-col rounded-lg border border-white/10 bg-cell p-5 transition-[border-color,transform,background-color] duration-200 ease-out hover:-translate-y-0.5 hover:border-white/20 hover:bg-[#13151a]">
                    <div class="flex items-baseline gap-2.5">
                        <span class="min-w-0 flex-1 truncate font-mono text-[14.5px] text-ink">{m.name}</span>
                        <span class:list={['font-mono text-[10.5px]', m.kind === 'static' ? 'text-acc/70' : 'text-comment']}>{m.kind}</span>
                    </div>
                    <div class="mt-2 mb-4 text-[13.5px] leading-[1.6] text-soft">{m.desc}</div>
                    <div class="mt-auto flex items-baseline justify-between gap-4 border-t border-white/6 pt-3 font-mono text-[11px] text-faint">
                        <span>{m.license}</span>
                        <ArrowRight size={12} class="shrink-0 self-center text-comment"/>
                    </div>
                </a>
        ))}
    </div>

    <p class="m-0 mt-5 text-[16px] leading-[1.75] text-body">Everything from the Debian and Ubuntu official builds is included too. Build scripts and packaging live at <a href="https://github.com/u-sb/nginx-source" target="_blank" rel="noopener">u-sb/nginx-source</a>.</p>
</DocsLayout>
