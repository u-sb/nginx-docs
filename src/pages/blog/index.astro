---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogPostList from '@/components/BlogPostList.astro';
import Pagination from '@/components/Pagination.astro';
import {getBlogPosts} from '@/lib/posts';
import website_config from '@/lib/website_config';

const allPosts = await getBlogPosts();
const perPage = website_config.perPage;
const totalPages = Math.ceil(allPosts.length / perPage);
const posts = allPosts.slice(0, perPage);
---
<BaseLayout title="Blog"
            description="Release announcements and news from the n.wtf nginx repository."
            canonical="/blog/">
    <div class="mx-auto w-full max-w-[1120px] px-8 pt-[52px]">
        <div class="font-mono text-[12.5px] text-faint">
            <a href="/" class="text-faint transition-colors hover:text-ink">~</a> / blog
        </div>
        <h1 class="mt-4 font-display text-[clamp(34px,4.4vw,52px)] leading-[1.05] font-bold tracking-[-1.6px] text-ink">Blog</h1>
        <p class="mt-3.5 max-w-[760px] text-[17px] leading-[1.6] text-soft">
            Release announcements and news from the <span class="font-mono text-[15px] text-[#e3e5e8]">n.wtf</span> repository.
            Browse posts <a href="/tags/">by tag</a>.
        </p>
    </div>

    <div class="mx-auto w-full max-w-[1120px] px-8 pt-11 pb-16">
        <div class="max-w-[960px]">
            <BlogPostList posts={posts}/>
            <Pagination currentPage={1} totalPages={totalPages} baseUrl="/blog"/>
        </div>
    </div>
</BaseLayout>
