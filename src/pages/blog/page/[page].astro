---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogPostList from '@/components/BlogPostList.astro';
import Pagination from '@/components/Pagination.astro';
import {getBlogPosts} from '@/lib/posts';
import website_config from '@/lib/website_config';

export async function getStaticPaths() {
    const allPosts = await getBlogPosts();
    const perPage = website_config.perPage;
    const totalPages = Math.ceil(allPosts.length / perPage);
    // Pages 2..N (page 1 lives at /blog/)
    return Array.from({length: Math.max(0, totalPages - 1)}, (_, i) => {
        const page = i + 2;
        return {params: {page: String(page)}, props: {page}};
    });
}

const {page} = Astro.props;
const allPosts = await getBlogPosts();
const perPage = website_config.perPage;
const totalPages = Math.ceil(allPosts.length / perPage);
const start = (page - 1) * perPage;
const posts = allPosts.slice(start, start + perPage);
---
<BaseLayout title={`Blog - Page ${page}`}
            description={`Release announcements and news from the n.wtf nginx repository. Page ${page} of ${totalPages}.`}
            canonical={`/blog/page/${page}/`}>
    <div class="mx-auto w-full max-w-[1120px] px-8 pt-[52px]">
        <div class="font-mono text-[12.5px] text-faint">
            <a href="/" class="text-faint transition-colors hover:text-ink">~</a> /
            <a href="/blog/" class="text-faint transition-colors hover:text-ink">blog</a> / page / {page}
        </div>
        <h1 class="mt-4 font-display text-[clamp(34px,4.4vw,52px)] leading-[1.05] font-bold tracking-[-1.6px] text-ink">Blog</h1>
        <p class="mt-3.5 max-w-[600px] font-mono text-[13px] text-faint">Page {page} of {totalPages}</p>
    </div>

    <div class="mx-auto w-full max-w-[1120px] px-8 pt-11 pb-16">
        <div class="max-w-[820px]">
            <BlogPostList posts={posts}/>
            <Pagination currentPage={page} totalPages={totalPages} baseUrl="/blog"/>
        </div>
    </div>
</BaseLayout>
