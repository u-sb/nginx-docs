---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TagList from '@/components/TagList.astro';
import {getBlogPosts} from '@/lib/posts';

const posts = await getBlogPosts();
const counts = new Map<string, number>();
for (const post of posts) {
    for (const tag of post.data.tags) {
        counts.set(tag, (counts.get(tag) ?? 0) + 1);
    }
}
const tags = [...counts.entries()].map(([name, count]) => ({name, count}));
---
<BaseLayout title="Tags"
            description="Browse n.wtf blog posts by tag."
            canonical="/tags/">
    <div class="mx-auto w-full max-w-[1120px] px-8 pt-[52px]">
        <div class="font-mono text-[12.5px] text-faint">
            <a href="/" class="text-faint transition-colors hover:text-ink">~</a> / tags
        </div>
        <h1 class="mt-4 font-display text-[clamp(34px,4.4vw,52px)] leading-[1.05] font-bold tracking-[-1.6px] text-ink">Tags</h1>
        <p class="mt-3.5 max-w-[600px] text-[17px] leading-[1.6] text-soft">
            All <a href="/blog/">blog</a> posts, grouped by tag.
        </p>
    </div>

    <div class="mx-auto w-full max-w-[1120px] px-8 pt-11 pb-16">
        <div class="max-w-[820px]">
            <TagList tags={tags}/>
        </div>
    </div>
</BaseLayout>
