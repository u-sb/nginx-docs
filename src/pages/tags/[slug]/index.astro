---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogPostList from '@/components/BlogPostList.astro';
import Pagination from '@/components/Pagination.astro';
import {getBlogPosts, getPostsByTag, originTagName, tagSlug} from '@/lib/posts';
import website_config from '@/lib/website_config';

export async function getStaticPaths() {
    const posts = await getBlogPosts();
    const slugs = new Set<string>();
    for (const post of posts) {
        for (const tag of post.data.tags) slugs.add(tagSlug(tag));
    }
    return [...slugs].map((slug) => ({params: {slug}}));
}

const {slug} = Astro.params;
const allPosts = await getPostsByTag(slug!);
const perPage = website_config.perPage;
const totalPages = Math.ceil(allPosts.length / perPage);
const posts = allPosts.slice(0, perPage);
const tagName = originTagName(allPosts, slug!);
---
<BaseLayout title={`Posts tagged "${tagName}"`}
            description={`Browse all n.wtf blog posts tagged with "${tagName}".`}
            canonical={`/tags/${slug}/`}>
    <div class="mx-auto w-full max-w-[1120px] px-8 pt-[52px]">
        <div class="font-mono text-[12.5px] text-faint">
            <a href="/" class="text-faint transition-colors hover:text-ink">~</a> /
            <a href="/tags/" class="text-faint transition-colors hover:text-ink">tags</a> / {slug}
        </div>
        <h1 class="mt-4 font-display text-[clamp(34px,4.4vw,52px)] leading-[1.05] font-bold tracking-[-1.6px] text-ink">#{tagName}</h1>
        <p class="mt-3.5 max-w-[760px] text-[17px] leading-[1.6] text-soft">
            {allPosts.length === 1 ? '1 post' : `${allPosts.length} posts`} tagged
            <span class="font-mono text-[15px] text-[#e3e5e8]">#{tagName}</span>.
        </p>
    </div>

    <div class="mx-auto w-full max-w-[1120px] px-8 pt-11 pb-16">
        <div>
            <BlogPostList posts={posts} activeTag={slug}/>
            <Pagination currentPage={1} totalPages={totalPages} baseUrl={`/tags/${slug}`}/>
        </div>
    </div>
</BaseLayout>
