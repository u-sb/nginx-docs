---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="404 — Page Not Found" description="This page does not exist." noindex>
    <main class="mx-auto flex w-full max-w-[1120px] flex-1 flex-col justify-center px-8 py-16">
        <div class="font-mono text-[12px] text-faint">~ / <span class="text-mute">404</span></div>
        <h1 class="mt-5 font-mono text-[72px] font-bold leading-none tracking-[-2px] text-ink sm:text-[96px]">
            4<span class="text-acc">0</span>4
        </h1>
        <p class="mt-4 text-[15px] text-body">This page does not exist.</p>

        <div class="mt-8 max-w-[560px] overflow-hidden rounded-lg border border-white/11 bg-panel">
            <div class="flex items-center gap-2 border-b border-white/8 px-4 py-2.5">
                <span class="h-[9px] w-[9px] rounded-full bg-white/12"></span>
                <span class="h-[9px] w-[9px] rounded-full bg-white/12"></span>
                <span class="h-[9px] w-[9px] rounded-full bg-white/12"></span>
                <span class="ml-2 font-mono text-[11px] text-faint">sh</span>
            </div>
            <div class="bg-cell px-4 py-3.5 font-mono text-[13px] leading-relaxed">
                <div><span class="text-faint">$</span> <span class="text-body">curl -I https://n.wtf<span id="notfound-path">/…</span></span></div>
                <div class="text-mute">HTTP/2 <span class="text-acc">404</span> Not Found</div>
            </div>
        </div>
        <script>
            const el = document.getElementById('notfound-path');
            if (el) el.textContent = window.location.pathname;
        </script>

        <div class="mt-8 flex flex-wrap gap-4 font-mono text-[13px]">
            <a href="/" class="rounded-md border border-white/11 px-4 py-2 text-soft transition-colors hover:border-white/20 hover:text-ink">cd ~/</a>
            <a href="/intro/" class="rounded-md border border-white/11 px-4 py-2 text-soft transition-colors hover:border-white/20 hover:text-ink">Introduction →</a>
        </div>
    </main>
</BaseLayout>
